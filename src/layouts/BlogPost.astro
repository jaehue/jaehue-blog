---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.tsx';
import { SITE, DEFAULT_LANG, LANGUAGES } from '../consts';

interface PostLink {
  slug: string;
  title: string;
  titles?: Record<string, string>;
}

interface Translation {
  lang: string;
  label: string;
  title: string;
  Content: any;
}

interface Props {
  title: string;
  description?: string;
  date: string;
  categories?: string[];
  tags?: string[];
  thumbnail?: string;
  postSlug?: string;
  prev?: PostLink | null;
  next?: PostLink | null;
  translations?: Translation[];
}

const { title, description, date, categories = [], tags = [], thumbnail, postSlug, prev = null, next = null, translations = [] } = Astro.props;
const hasTranslations = translations.length > 0;
const defaultLabel = LANGUAGES[DEFAULT_LANG] ?? DEFAULT_LANG;

const formattedDate = new Date(date).toLocaleDateString('ko-KR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const imageURL = thumbnail
  ? new URL(thumbnail, Astro.site ?? SITE.url).href
  : undefined;

// 검색엔진용 구조화 데이터 (BlogPosting schema)
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description ? { description } : {}),
  datePublished: new Date(date).toISOString(),
  ...(imageURL ? { image: imageURL } : {}),
  author: { '@type': 'Person', name: SITE.author },
  publisher: { '@type': 'Person', name: SITE.author },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
---

<BaseLayout title={title} description={description} image={thumbnail} type="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <article class="mt-6" data-pagefind-body>
    <header class="mb-10 pb-8 border-b border-(--color-border)">
      {hasTranslations && (
        <div class="flex justify-end mb-4" data-pagefind-ignore>
          <div
            class="inline-flex gap-0.5 p-0.5 rounded-full border border-(--color-border)"
            data-lang-switch
            data-default-lang={DEFAULT_LANG}
            role="group"
            aria-label="언어 선택 / Language"
          >
            <button type="button" class="lang-btn" data-lang-btn={DEFAULT_LANG}>{defaultLabel}</button>
            {translations.map((t) => (
              <button type="button" class="lang-btn" data-lang-btn={t.lang}>{t.label}</button>
            ))}
          </div>
        </div>
      )}
      <h1 class="text-[2rem] font-bold leading-snug tracking-tight mb-3" data-lang-title={DEFAULT_LANG}>{title}</h1>
      {translations.map((t) => (
        <h1 class="text-[2rem] font-bold leading-snug tracking-tight mb-3 hidden" data-lang-title={t.lang} data-pagefind-ignore>{t.title}</h1>
      ))}
      <div class="flex items-center gap-3 text-sm text-(--color-text-muted)">
        <time>{formattedDate}</time>
        {categories.length > 0 && (
          <>
            <span class="text-(--color-border)">·</span>
            {categories.map((cat, i) => (
              <>
                <a href={`/categories/${encodeURIComponent(cat)}`} class="hover:text-(--color-text) transition-colors">
                  {cat}
                </a>
                {i < categories.length - 1 && <span>,</span>}
              </>
            ))}
          </>
        )}
      </div>
    </header>

    {thumbnail && (
      <img
        src={thumbnail}
        alt={title}
        class="w-full max-h-[420px] object-cover rounded-lg mb-10 bg-(--color-border)"
        data-pagefind-ignore
      />
    )}

    <div class="blog-content" data-lang-body={DEFAULT_LANG}>
      <slot />
    </div>
    {translations.map((t) => {
      const TranslatedContent = t.Content;
      return (
        <div class="blog-content hidden" data-lang-body={t.lang} data-pagefind-ignore>
          <TranslatedContent />
        </div>
      );
    })}

    {tags.length > 0 && (
      <div class="mt-16 pt-8 border-t border-(--color-border)">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${encodeURIComponent(tag)}`}
              class="text-[13px] px-2.5 py-1 bg-(--color-surface) rounded-full
                     text-(--color-text-muted) hover:text-(--color-text) hover:bg-(--color-border) transition-colors"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    {(prev || next) && (
      <nav class="mt-16 pt-8 border-t border-(--color-border) grid grid-cols-1 sm:grid-cols-2 gap-3" data-pagefind-ignore aria-label="글 둘러보기">
        {prev ? (
          <a
            href={`/post/${prev.slug}`}
            data-nav="prev"
            data-nav-slug={prev.slug}
            data-nav-base={prev.title}
            data-nav-titles={JSON.stringify(prev.titles ?? {})}
            class="group flex flex-col gap-1.5 p-4 rounded-lg border border-(--color-border) hover:bg-(--color-surface) transition-colors"
          >
            <span class="text-xs text-(--color-text-muted) flex items-center gap-1">
              <span aria-hidden="true">←</span> <span data-nav-label>이전 글</span>
            </span>
            <span class="text-sm leading-snug group-hover:text-(--color-text) transition-colors line-clamp-2" data-nav-title>{prev.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
        {next ? (
          <a
            href={`/post/${next.slug}`}
            data-nav="next"
            data-nav-slug={next.slug}
            data-nav-base={next.title}
            data-nav-titles={JSON.stringify(next.titles ?? {})}
            class="group flex flex-col gap-1.5 p-4 rounded-lg border border-(--color-border) hover:bg-(--color-surface) transition-colors sm:text-right sm:items-end"
          >
            <span class="text-xs text-(--color-text-muted) flex items-center gap-1">
              <span data-nav-label>다음 글</span> <span aria-hidden="true">→</span>
            </span>
            <span class="text-sm leading-snug group-hover:text-(--color-text) transition-colors line-clamp-2" data-nav-title>{next.title}</span>
          </a>
        ) : <span class="hidden sm:block" />}
      </nav>
    )}

    {postSlug && (
      <div data-pagefind-ignore>
        <Comments postSlug={postSlug} client:visible />
      </div>
    )}
  </article>
</BaseLayout>

<script>
  // 다국어 전환. ?lang=xx 쿼리 파라미터로 진입 시 해당 언어로 바로 노출.
  // 파일명 `{slug}.{lang}.md` 규칙으로 추가된 번역본을 자동으로 처리한다.
  (function () {
    const sw = document.querySelector('[data-lang-switch]');
    if (!sw) return;

    const DEFAULT = sw.getAttribute('data-default-lang') || 'ko';
    const buttons = Array.from(sw.querySelectorAll('[data-lang-btn]'));
    const langs = buttons.map((b) => b.getAttribute('data-lang-btn'));
    const bodies = document.querySelectorAll('[data-lang-body]');
    const titles = document.querySelectorAll('[data-lang-title]');

    // 이전/다음 글 링크 라벨 (언어별)
    const NAV = {
      ko: { prev: '이전 글', next: '다음 글' },
      mn: { prev: 'Өмнөх бичлэг', next: 'Дараах бичлэг' },
      en: { prev: 'Previous', next: 'Next' },
      ja: { prev: '前の記事', next: '次の記事' },
      zh: { prev: '上一篇', next: '下一篇' },
    };

    // 언어 전환 시 하단 이전/다음 글을 해당 언어 번역본(있으면)의 제목·링크로 갱신
    function updateNav(lang) {
      document.querySelectorAll('[data-nav]').forEach((a) => {
        const slug = a.getAttribute('data-nav-slug');
        const base = a.getAttribute('data-nav-base') || '';
        let navTitles = {};
        try { navTitles = JSON.parse(a.getAttribute('data-nav-titles') || '{}'); } catch (e) {}
        const hasTranslation = lang !== DEFAULT && navTitles[lang] != null;

        const titleEl = a.querySelector('[data-nav-title]');
        if (titleEl) titleEl.textContent = hasTranslation ? navTitles[lang] : base;
        a.setAttribute('href', hasTranslation ? `/post/${slug}?lang=${lang}` : `/post/${slug}`);

        const labelEl = a.querySelector('[data-nav-label]');
        const kind = a.getAttribute('data-nav');
        const labels = NAV[lang] || NAV[DEFAULT];
        if (labelEl && labels) labelEl.textContent = labels[kind];
      });
    }

    function setLang(lang) {
      if (!langs.includes(lang)) lang = DEFAULT;
      bodies.forEach((el) => el.classList.toggle('hidden', el.getAttribute('data-lang-body') !== lang));
      titles.forEach((el) => el.classList.toggle('hidden', el.getAttribute('data-lang-title') !== lang));
      buttons.forEach((b) => b.setAttribute('aria-current', b.getAttribute('data-lang-btn') === lang ? 'true' : 'false'));
      document.documentElement.lang = lang;
      updateNav(lang);

      const url = new URL(window.location.href);
      if (lang === DEFAULT) url.searchParams.delete('lang');
      else url.searchParams.set('lang', lang);
      history.replaceState(null, '', url);
    }

    const initial = new URLSearchParams(window.location.search).get('lang') || DEFAULT;
    setLang(initial);

    buttons.forEach((b) => b.addEventListener('click', () => setLang(b.getAttribute('data-lang-btn'))));
  })();
</script>

<style is:global>
  /* 언어 전환 버튼 */
  .lang-btn {
    font-size: 13px;
    line-height: 1;
    padding: 0.45em 0.95em;
    border-radius: 9999px;
    color: var(--color-text-muted);
    background: transparent;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.15s, color 0.15s;
  }

  .lang-btn:hover {
    color: var(--color-text);
  }

  .lang-btn[aria-current='true'] {
    background: var(--color-text);
    color: #fff;
  }

  .blog-content {
    font-size: 1rem;
    line-height: 1.8;
    color: #1a1a1a;
  }

  .blog-content p {
    margin-top: 0;
    margin-bottom: 1.75em;
  }

  .blog-content h1 {
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.3;
    margin-top: 2.5em;
    margin-bottom: 0.8em;
    letter-spacing: -0.02em;
  }

  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.35;
    margin-top: 2.5em;
    margin-bottom: 0.8em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid #e5e5e3;
    letter-spacing: -0.02em;
  }

  .blog-content h3 {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    margin-top: 2em;
    margin-bottom: 0.6em;
    letter-spacing: -0.01em;
  }

  .blog-content h4 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
  }

  .blog-content blockquote {
    font-style: normal;
    border-left: 3px solid #e5e5e3;
    padding-left: 1.25em;
    margin: 2em 0;
    color: #555;
  }

  .blog-content blockquote p {
    margin-bottom: 0.75em;
  }

  .blog-content img {
    border-radius: 0.375rem;
    margin: 2em auto;
    max-width: 100%;
    height: auto;
    display: block;
  }

  .blog-content a {
    color: #2563eb;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #93c5fd;
  }

  .blog-content a:hover {
    text-decoration-color: #2563eb;
  }

  .blog-content hr {
    border: none;
    border-top: 1px solid #e5e5e3;
    margin: 3em 0;
  }

  .blog-content code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: #f4f4f2;
    padding: 0.2em 0.4em;
    border-radius: 0.25rem;
    font-weight: 400;
  }

  .blog-content pre {
    background: #f4f4f2;
    border: 1px solid #e5e5e3;
    border-radius: 0.5rem;
    padding: 1.25em 1.5em;
    overflow-x: auto;
    margin: 2em 0;
  }

  .blog-content pre code {
    background: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: #1a1a1a;
    font-weight: 400;
  }

  .blog-content ul, .blog-content ol {
    margin: 1.25em 0;
    padding-left: 1.75em;
  }

  .blog-content li {
    margin-bottom: 0.5em;
    line-height: 1.85;
  }

  .blog-content strong {
    font-weight: 700;
  }

  .blog-content table {
    width: 100%;
    margin: 2em 0;
    font-size: 0.9em;
  }

  .blog-content th {
    font-weight: 600;
    border-bottom: 2px solid #e5e5e3;
    padding: 0.5em 1em;
    text-align: left;
  }

  .blog-content td {
    border-bottom: 1px solid #e5e5e3;
    padding: 0.5em 1em;
  }
</style>
