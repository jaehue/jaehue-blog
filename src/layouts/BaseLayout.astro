---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** OG 이미지 (루트 기준 경로 또는 절대 URL). 없으면 기본값 사용 */
  image?: string;
  /** 페이지 유형 */
  type?: 'website' | 'article';
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
} = Astro.props;
const currentPath = Astro.url.pathname;

// 검색/공유용 메타 계산
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const metaDescription = (description && description.trim()) || SITE.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const resolvedImage = image || SITE.defaultOgImage;
const ogImageURL = resolvedImage
  ? new URL(resolvedImage, Astro.site ?? SITE.url).href
  : undefined;

const navItems = [
  { href: '/post', label: '글' },
  { href: '/tags', label: '태그' },
  { href: '/about', label: '소개' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', Astro.site ?? SITE.url).href} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P5BBFN04HQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P5BBFN04HQ');
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="bg-(--color-bg) text-(--color-text) font-sans antialiased min-h-screen flex flex-col">
    <div class="max-w-[640px] w-full mx-auto px-5 flex-1 flex flex-col">
      <header class="py-10">
        <nav class="flex items-center justify-between">
          <a href="/" class="text-xl font-semibold tracking-tight hover:opacity-60 transition-opacity">
            장재휴
          </a>
          <div class="flex gap-5 text-sm text-(--color-text-muted)">
            {navItems.map(({ href, label }) => (
              <a
                href={href}
                class:list={[
                  'hover:text-(--color-text) transition-colors',
                  currentPath.startsWith(href) && 'text-(--color-text) font-medium',
                ]}
              >
                {label}
              </a>
            ))}
          </div>
        </nav>
      </header>

      <main class="flex-1 pb-16">
        <slot />
      </main>

      <footer class="py-8 border-t border-(--color-border)">
        <p class="text-sm text-(--color-text-muted)">© {new Date().getFullYear()} 장재휴</p>
      </footer>
    </div>
  </body>
</html>
