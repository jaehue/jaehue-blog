---
import '../styles/global.css';
import { SITE } from '../consts';

interface Props {
  title: string;
  description?: string;
  /** OG 이미지 (루트 기준 경로 또는 절대 URL). 없으면 기본값 사용 */
  image?: string;
  /** 페이지 유형 */
  type?: 'website' | 'article';
  /** 글 발행일 */
  publishedTime?: string;
  /** 글 수정일 */
  modifiedTime?: string;
  /** 글 태그 */
  tags?: string[];
}

const {
  title,
  description = SITE.description,
  image,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags = [],
} = Astro.props;
const currentPath = Astro.url.pathname;

// 검색/공유용 메타 계산
const pageTitle = title === SITE.title ? title : `${title} · ${SITE.title}`;
const metaDescription = (description && description.trim()) || SITE.description;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const resolvedImage = image || SITE.defaultOgImage;
const ogImageURL = resolvedImage
  ? new URL(resolvedImage, Astro.site ?? SITE.url).href
  : undefined;

const navItems = [
  { href: '/post', label: '글' },
  { href: '/tags', label: '태그' },
  { href: '/search', label: '검색' },
  { href: '/about', label: '소개' },
];
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={new Date(publishedTime).toISOString()} />}
    {type === 'article' && (modifiedTime || publishedTime) && <meta property="article:modified_time" content={new Date(modifiedTime || publishedTime).toISOString()} />}
    {type === 'article' && <meta property="article:author" content={SITE.author} />}
    {type === 'article' && tags.filter(Boolean).map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={ogImageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <slot name="head" />

    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={new URL('/rss.xml', Astro.site ?? SITE.url).href} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css"
      rel="stylesheet"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-P5BBFN04HQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-P5BBFN04HQ');
    </script>
    <title>{pageTitle}</title>
  </head>
  <body class="bg-(--color-bg) text-(--color-text) font-sans antialiased min-h-screen flex flex-col">
    <div class="max-w-[640px] w-full mx-auto px-5 flex-1 flex flex-col">
      <header class="py-10">
        <nav class="flex items-center justify-between">
          <a href="/" class="text-xl font-semibold tracking-tight hover:opacity-60 transition-opacity">
            장재휴
          </a>
          <div class="flex gap-5 text-sm text-(--color-text-muted)">
            {navItems.map(({ href, label }) => (
              <a
                href={href}
                class:list={[
                  'hover:text-(--color-text) transition-colors',
                  currentPath.startsWith(href) && 'text-(--color-text) font-medium',
                ]}
              >
                {label}
              </a>
            ))}
          </div>
        </nav>
      </header>

      <main class="flex-1 pb-16">
        <slot />
      </main>

      <footer class="py-8 border-t border-(--color-border) flex items-center justify-between gap-4">
        <p class="text-sm text-(--color-text-muted)">© {new Date().getFullYear()} 장재휴</p>
        <div class="flex items-center gap-4 text-(--color-text-muted)">
          {SITE.social.facebook && (
            <a
              href={SITE.social.facebook}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="페이스북"
              class="hover:text-(--color-text) transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" />
              </svg>
            </a>
          )}
          {SITE.social.instagram && (
            <a
              href={SITE.social.instagram}
              target="_blank"
              rel="me noopener noreferrer"
              aria-label="인스타그램"
              class="hover:text-(--color-text) transition-colors"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37Z" />
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
              </svg>
            </a>
          )}
        </div>
      </footer>
    </div>
  </body>
</html>
