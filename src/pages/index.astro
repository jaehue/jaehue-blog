---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 10);
---

<BaseLayout title="장재휴">
  <section class="mt-8 mb-8">
    <p class="text-2xl leading-relaxed tracking-tight">
    공부하는 유목민
    </p>
  </section>

  <section class="mb-14">
    <form action="/search" method="get" role="search" class="relative max-w-xs">
      <svg aria-hidden="true" class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-(--color-text-muted)" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        id="home-search"
        type="search"
        name="q"
        placeholder="글 검색…"
        autocomplete="off"
        aria-label="블로그 글 검색"
        class="w-full rounded-full border border-(--color-border) bg-(--color-surface) py-2 pl-9 pr-4 text-sm placeholder:text-(--color-text-muted) focus:outline-none focus:border-(--color-text-muted) transition-colors"
      />
    </form>
  </section>

  <script is:inline>
    (() => {
      const input = document.getElementById('home-search');
      if (!input) return;
      let navigated = false;
      const go = () => {
        if (navigated) return;
        navigated = true;
        const q = input.value.trim();
        // 입력하려고 포커스하는 즉시 전용 검색 페이지로 이동 (한글 IME 글자 유실 없음)
        window.location.href = '/search' + (q ? '?q=' + encodeURIComponent(q) : '');
      };
      input.addEventListener('focus', go);
    })();
  </script>

  <section>
    <h2 class="text-xs font-medium text-(--color-text-muted) uppercase tracking-widest mb-8">최근 글</h2>
    <ul class="space-y-4">
      {posts.map((post) => {
        const date = new Date(post.data.date).toLocaleDateString('ko-KR', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <li>
            <a href={`/post/${post.id}`} class="group block border border-(--color-border) rounded-lg p-5 bg-(--color-surface) hover:border-(--color-text-muted) transition-colors">
              <h3 class="text-base font-medium leading-snug">
                {post.data.title}
              </h3>
              {post.data.description && (
                <p class="text-sm text-(--color-text-muted) mt-1.5 leading-relaxed line-clamp-1">{post.data.description}</p>
              )}
              <time class="text-sm text-(--color-text-muted) mt-2 block">{date}</time>
            </a>
          </li>
        );
      })}
    </ul>
    <div class="mt-10">
      <a href="/post" class="text-sm text-(--color-text-muted) hover:text-(--color-text) transition-colors">
        모든 글 보기 →
      </a>
    </div>
  </section>
</BaseLayout>
