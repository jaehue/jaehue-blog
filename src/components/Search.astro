---
interface Props {
  placeholder?: string;
}
const { placeholder = '글 검색…' } = Astro.props;
---

<div id="search"></div>
<p id="search-fallback" class="text-sm text-(--color-text-muted) mt-2 hidden">
  검색 인덱스는 빌드 후 생성됩니다. 배포된 사이트에서 동작합니다.
</p>

<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js" onerror="document.getElementById('search-fallback')?.classList.remove('hidden')"></script>
<script is:inline define:vars={{ placeholder }}>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI === 'undefined') {
      document.getElementById('search-fallback')?.classList.remove('hidden');
      return;
    }
    new PagefindUI({
      element: '#search',
      showSubResults: true,
      showImages: false,
      translations: {
        placeholder,
        clear_search: '지우기',
        load_more: '결과 더 보기',
        search_label: '블로그 검색',
        zero_results: '[SEARCH_TERM]에 대한 결과가 없습니다',
        many_results: '[SEARCH_TERM]에 대한 결과 [COUNT]개',
        one_result: '[SEARCH_TERM]에 대한 결과 [COUNT]개',
        searching: '[SEARCH_TERM] 검색 중…',
      },
    });

    // URL ?q= 가 있으면 자동 검색
    const q = new URLSearchParams(location.search).get('q');
    if (q) {
      const input = document.querySelector('#search .pagefind-ui__search-input');
      if (input) {
        input.value = q;
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-primary: #1a1a1a;
    --pagefind-ui-text: #1a1a1a;
    --pagefind-ui-background: var(--color-bg);
    --pagefind-ui-border: #e5e5e3;
    --pagefind-ui-tag: var(--color-surface);
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-font: inherit;
  }
</style>
